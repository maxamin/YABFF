'=============================================================================
' WAF-BAN detector — design model (PlantUML), built on feroxbuster internals
'
' Proposed new module:  ferox-ml-core/src/waf.rs  (pub mod waf) + a thin
' observer wired into feroxbuster-ml/src/scanner/requester.rs.
' Status: DESIGN ONLY — no code applied. This file is the blueprint.
'
' GREATER GOAL
'   Decide, per site, whether the target's WAF/edge has BANNED us (sustained
'   block) versus a transient hiccup — and react — by REUSING feroxbuster's
'   existing rate/error-reaction machinery instead of building a parallel
'   pipeline. feroxbuster already:
'     * tallies per-scan 403s / 429s / errors / requests   (FeroxScan)
'     * tallies global timeouts / conn / TLS / 5xx / wildcards (Stats)
'     * decides when a threshold is crossed      (Requester::should_enforce_policy)
'     * reacts by slowing down or stopping       (tune / bail, RequesterPolicy)
'     * learns per-dir block pages               (HeuristicTests + WildcardFilter)
'   The detector is a SMALL classifier/aggregator on top of these facts; it adds
'   only what feroxbuster lacks: ban-vs-transient persistence, mid-scan block-page
'   shift detection, vendor attribution, and a single explainable verdict that
'   routes back into the EXISTING tune()/bail() path.
'
' Legend:  <<ferox>> = already exists in feroxbuster-ml (REUSED, unchanged)
'          <<new>>   = proposed addition in this design
'=============================================================================

@startuml waf_ban_classes
title WAF-ban detector — class model (reuses feroxbuster internals)

skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
skinparam class {
  BackgroundColor<<ferox>> #EAF3FF
  BorderColor<<ferox>>     #2F6FB0
  BackgroundColor<<new>>   #FFF3D6
  BorderColor<<new>>       #B07A00
}

'================= existing feroxbuster facilities (reused verbatim) =========
package "feroxbuster (existing)" <<Frame>> {

  class FeroxScan <<ferox>> {
    -status_403s : AtomicUsize
    -status_429s : AtomicUsize
    -errors : AtomicUsize
    +requests() : u64
    +num_errors(t : PolicyTrigger) : usize
    +add_403()
    +add_429()
  }

  class Stats <<ferox>> {
    -timeouts : AtomicUsize
    -connection_errors : AtomicUsize
    -certificate_errors : AtomicUsize
    -status_403s / status_429s : AtomicUsize
    -status_500s / status_503s : AtomicUsize
    -wildcards_filtered : AtomicUsize
    +update_f(field : StatField)
  }
  enum StatField <<ferox>>
  enum StatError <<ferox>>

  enum PolicyTrigger <<ferox>> {
    Status403
    Status429
    Errors
    TryAdjustUp
  }
  enum RequesterPolicy <<ferox>> {
    AutoTune
    AutoBail
    Default
  }
  class PolicyData <<ferox>> {
    +policy : RequesterPolicy
    +cooling_down : AtomicBool
    +wait_time : u64
    +errors : [AtomicUsize; 3]
    +heap : RwLock<LimitHeap>
    +rate_limit : Option<usize>
  }
  class LimitHeap <<ferox>>

  class Requester <<ferox>> {
    -ferox_scan : Arc<FeroxScan>
    -policy_data : PolicyData
    -handles : Arc<Handles>
    +should_enforce_policy() : Option<PolicyTrigger>
    -too_many_errors() : bool          ' total >= max(threads/2, 25)
    -too_many_status_errors(t) : bool  ' 403 ratio>=0.90, 429 ratio>=0.30
    +tune(t : PolicyTrigger)           ' slow down via LimitHeap
    +bail(t : PolicyTrigger)           ' stop this scan
    +cool_down()
  }
  note bottom of Requester
    HIGH_ERROR_RATIO = 0.90 (lib.rs). Request floor before any
    enforcement: requests >= max(threads, 50). These are the
    thresholds the detector reuses — it does NOT re-invent them.
  end note

  class HeuristicTests <<ferox>> {
    +detect_404_like_responses(...) : Vec<WildcardFilter>
    +connectivity(targets) : Vec<String>
  }
  class WildcardFilter <<ferox>>
  class SimilarityFilter <<ferox>>

  class FeroxResponse <<ferox>> {
    +url : String
    +status() : StatusCode
    +headers() : HeaderMap
    +content_length() : u64
  }
}

'================= new, thin additions ======================================
package "ferox-ml-core::waf (new)" <<Frame>> {

  enum BanState <<new>> {
    Clear
    RateLimited
    Throttled
    Banned
    Bailed
  }

  class BanSignals <<new>> {
    .. a snapshot DERIVED from existing tallies (no new counting) ..
    +requests : u64
    +ratio_403 : f64        ' FeroxScan.num_errors(Status403)/requests
    +ratio_429 : f64        ' FeroxScan.num_errors(Status429)/requests
    +error_count : usize    ' FeroxScan.num_errors(Errors)
    +retry_after : Option<u64>   ' from 429/503 FeroxResponse headers
    +new_wildcard_midscan : bool ' HeuristicTests produced a wildcard after warm-up
    +transport_spike : bool      ' Stats timeouts/conn/TLS rising
    +from(scan : &FeroxScan, stats : &Stats) : BanSignals
  }

  class VendorAttributor <<new>> {
    .. reads headers/cookies ALREADY on FeroxResponse ..
    +identify(resp : &FeroxResponse) : Option<WafVendor>
  }
  enum WafVendor <<new>> {
    Cloudflare
    Akamai
    AwsWafShield
    Imperva
    Sucuri
    Fastly
    ModSecurity
    Generic
    Unknown
  }

  class BanVerdict <<new>> {
    +state : BanState
    +trigger : Option<PolicyTrigger>   ' reuse feroxbuster's own enum
    +confidence : f64
    +vendor : Option<WafVendor>
    +persisted_intervals : u32         ' how long the trigger has held
    +evidence : Vec<String>
  }

  class WafBanDetector <<new>> {
    -policy : RequesterPolicy
    -state : BanState
    -consecutive_triggers : u32
    -warm : bool
    -attributor : VendorAttributor
    --
    +new(policy : RequesterPolicy) : WafBanDetector
    +observe_response(resp : &FeroxResponse)  ' attribution + retry-after only
    +classify(sig : &BanSignals, t : Option<PolicyTrigger>) : BanVerdict
    -is_sustained() : bool   ' trigger held across >= N cooldown intervals
    -reaction_for(v : &BanVerdict) : WafReaction
  }
  note right of WafBanDetector
    classify() does NOT re-scan or re-threshold: it takes the
    Option<PolicyTrigger> that Requester::should_enforce_policy()
    ALREADY produced, then adds the ban-specific judgement:
      * transient  = trigger fires once, clears after a tune()
      * BAN        = same trigger persists across cooldowns, OR a
                     403-wall (ratio_403 ~ 1.0), OR a block page
                     appears mid-scan (new_wildcard_midscan)
    Vendor + evidence make it explainable.
  end note

  enum WafReaction <<new>> {
    Continue
    Tune        ' -> Requester::tune()  (AutoTune path)
    Backoff     ' -> honor retry_after, then cool_down()
    Bail        ' -> Requester::bail()  (AutoBail path)
  }
}

'================= relationships: new COMPOSES existing =====================
BanSignals ..> FeroxScan      : derives from
BanSignals ..> Stats          : derives from
BanSignals ..> FeroxResponse  : retry_after
VendorAttributor ..> FeroxResponse : reads headers/cookies
VendorAttributor --> WafVendor

WafBanDetector *-- VendorAttributor
WafBanDetector ..> BanSignals : classify()
WafBanDetector --> BanVerdict : produces
WafBanDetector --> WafReaction
BanVerdict --> BanState
BanVerdict --> PolicyTrigger   : reuses
BanVerdict --> "0..1" WafVendor

' the detector slots INTO the existing requester decision point
Requester ..> WafBanDetector : feeds should_enforce_policy() result\n+ FeroxScan/Stats snapshot
WafReaction ..> Requester : Tune -> tune(), Bail -> bail(),\nBackoff -> cool_down()
BanSignals ..> HeuristicTests : new_wildcard_midscan via\ndetect_404_like_responses()
HeuristicTests --> WildcardFilter
HeuristicTests --> SimilarityFilter

@enduml


@startuml waf_ban_state
title WAF-ban state machine — layered on existing tune()/bail()

skinparam shadowing false
[*] --> Clear

state Clear {
  Clear : should_enforce_policy() == None
  Clear : reaction = Continue
}
state RateLimited {
  RateLimited : trigger == Status429 (ratio_429 >= 0.30)
  RateLimited : reaction = Backoff (honor Retry-After)
}
state Throttled {
  Throttled : trigger == Errors OR first Status403
  Throttled : reaction = Tune  (Requester::tune via LimitHeap)
}
state Banned {
  Banned : 403-wall ratio_403 >= 0.90 (HIGH_ERROR_RATIO)
  Banned : OR same trigger persists across cooldowns
  Banned : OR block page appears mid-scan (new wildcard)
  Banned : reaction = Bail if AutoBail else deep Backoff
}
state Bailed {
  Bailed : Requester::bail() called; sweep moves to next target
}

Clear --> RateLimited : should_enforce_policy()=Status429
Clear --> Throttled   : should_enforce_policy()=Errors|Status403
RateLimited --> Clear  : ratio_429 falls after Backoff
Throttled --> Clear    : tune() recovers, trigger clears
RateLimited --> Banned : 429 persists AND tune cannot recover
Throttled --> Banned   : trigger persists >= N cooldown intervals
Banned --> Bailed      : policy == AutoBail
Banned --> Throttled   : recovery after deep Backoff (AutoTune)
Bailed --> [*]

note right of Banned
  "persists across cooldowns" reuses PolicyData.cooling_down +
  wait_time: the detector counts how many enforcement intervals
  the SAME trigger survives. One-shot spike => transient (stay
  Throttled); sustained => ban. This is the single judgement the
  existing code does not make on its own.
end note
@enduml


@startuml waf_ban_sequence
title WAF-ban detection — inside the existing Requester scan loop

skinparam shadowing false
participant "Requester\n(scan loop)" as Req <<ferox>>
participant "FeroxScan /\nStats" as Tallies <<ferox>>
participant "WafBanDetector" as Det <<new>>
participant "HeuristicTests" as Heur <<ferox>>
participant "tune() / bail()\n/ cool_down()" as React <<ferox>>

loop per response (existing flow)
  Req -> Tallies : add_403/add_429/add_error (already happens)
  Req -> Det : observe_response(resp)
  note right of Det : vendor attribution + Retry-After\n(read headers already present)
end

== existing enforcement checkpoint (every interval) ==
Req -> Req : t = should_enforce_policy()  // existing thresholds
Req -> Tallies : requests(), num_errors(trigger)
Req -> Heur : block page shifted mid-scan? (new WildcardFilter)
Req -> Det : classify(BanSignals::from(scan,stats), t)
Det --> Req : BanVerdict {state, confidence, vendor, reaction}

alt reaction == Continue
  Req -> Req : proceed
else reaction == Tune
  Req -> React : tune(trigger)        // slow down, existing AutoTune
else reaction == Backoff
  Req -> React : cool_down()          // honor Retry-After, existing
else reaction == Bail
  Req -> React : bail(trigger)        // stop target, existing AutoBail
  note right of React : ml-loop sweep continues\nwith the next target
end
@enduml


'=============================================================================
' REUSE / TRACEABILITY — each ban signal maps to something feroxbuster already
' computes; the detector only interprets and persists.
'
'   ban signal              existing source (reused)
'   ----------------------  -------------------------------------------------
'   403 wall                FeroxScan.status_403s + too_many_status_errors()
'                           (ratio >= HIGH_ERROR_RATIO = 0.90)
'   429 rate-limit          FeroxScan.status_429s (ratio >= 0.30) + Retry-After
'   error/timeout storm     FeroxScan.errors + too_many_errors()
'                           (>= max(threads/2,25)); Stats timeouts/conn/TLS
'   canned block page       HeuristicTests::detect_404_like_responses ->
'                           a NEW WildcardFilter appearing after warm-up
'   vendor attribution      headers/cookies already on FeroxResponse
'   "is this sustained?"    PolicyData.cooling_down + wait_time intervals
'   reaction                Requester::tune()/bail()/cool_down(),
'                           RequesterPolicy::{AutoTune,AutoBail}
'
' Net new code is small: BanSignals (a read-only snapshot), VendorAttributor,
' and WafBanDetector.classify()/persistence. Everything else is wiring into
' the one decision point that already exists.
'=============================================================================
